<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HydrogenUiTests)' == 'true'">
    <DefineConstants>$(DefineConstants);HYDROGEN_UI_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HydrogenUiTests)' != 'true'">
    <Compile Remove="UiTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>
  <!-- Stage 1-3 may embed a project-specific UI/backend archive when making
       an unpackaged self-contained single-file WinUI application. Ordinary
       SDK/test builds do not set HydrogenUiArchive and are unchanged. -->
  <ItemGroup Condition="'$(HydrogenUiArchive)' != ''">
    <EmbeddedResource Include="$(HydrogenUiArchive)" LogicalName="Hydrogen.Native.EmbeddedUi.zip" />
  </ItemGroup>
</Project>
