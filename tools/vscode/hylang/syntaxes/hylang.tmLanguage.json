      "match": "\\b(?:public|private|protected|internal|static|virtual|override)\\b"
    },
    {
      "name": "storage.type.hylang",
      "match": "\\b(?:class|struct|interface|enum|namespace|using|void|byte|sbyte|short|ushort|int|uint|long|ulong|nint|nuint|bool|string|var)\\b"
    },
    {
      "name": "constant.language.hylang",
      "match": "\\b(?:true|false|null)\\b"
