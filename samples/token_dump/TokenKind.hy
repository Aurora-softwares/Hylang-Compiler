namespace TokenDump {
    public enum TokenKind {
        EndOfFile,
        Unknown,
        Identifier,
        Number,
        StringLiteral,
        OpenParen,
        CloseParen,
        OpenBrace,
        CloseBrace,
        OpenBracket,
        CloseBracket,
        Semicolon,
        Comma,
        Dot,
        Plus,
        Minus,
        Star,
        Slash,
        Percent,
        Bang,
        Equals,
        EqualsEquals,
        BangEquals,
        Less,
        LessEquals,
        Greater,
        GreaterEquals,
        AmpAmp,
        PipePipe,
        Using,
        Namespace,
        Class,
        Enum,
        Public,
        Private,
        Protected,
        Internal,
        Static,
        Void,
        Int,
        StringKeyword,
        Bool,
        True,
        False,
        Null,
        If,
        Else,
        While,
        For,
        Break,
        Continue,
        Return,
        New,
        This
    }
}
