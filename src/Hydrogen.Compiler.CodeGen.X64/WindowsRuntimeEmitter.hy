            if (ch == "7") { return 7; }
            if (ch == "8") { return 8; }
            if (ch == "9") { return 9; }
            if (ch == "a") { return 10; }
            if (ch == "b") { return 11; }
            if (ch == "c") { return 12; }
            if (ch == "d") { return 13; }
            if (ch == "e") { return 14; }
            if (ch == "f") { return 15; }
            return 0;
        }
    }
}
