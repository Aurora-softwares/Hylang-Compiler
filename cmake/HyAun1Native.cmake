foreach(required NATIVE_BINARY SOURCE_DIR TEMP_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEMP_DIR}")
set(project "${SOURCE_DIR}/tests/phase6/Aun1Hello.hyproj")
set(output "${TEMP_DIR}/hello.exec")
execute_process(COMMAND "${NATIVE_BINARY}" check "${project}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT result STREQUAL "0" OR NOT stdout MATCHES "check ok" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "AUN1 source check failed: ${result}\n${stdout}\n${stderr}")
endif()
execute_process(COMMAND "${NATIVE_BINARY}" build "${project}" -o "${output}" --hide-progress
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
if(NOT result STREQUAL "0" OR NOT stderr STREQUAL "")
    message(FATAL_ERROR "AUN1 build failed: ${result}\n${stdout}\n${stderr}")
endif()
file(READ "${output}" image HEX)
file(SIZE "${output}" size)
string(SUBSTRING "${image}" 0 8 magic)
string(SUBSTRING "${image}" 8 2 length_low)
string(SUBSTRING "${image}" 10 2 length_high)
string(SUBSTRING "${image}" 12 20 version_and_reserved)
math(EXPR code_length "0x${length_high}${length_low}")
math(EXPR expected_size "16 + ${code_length}")
if(NOT magic STREQUAL "41554e31" OR
   NOT version_and_reserved STREQUAL "02000000000000000000" OR
   code_length LESS 1 OR code_length GREATER 4096 OR
   NOT size EQUAL expected_size)
    message(FATAL_ERROR "AUN1 v2 header or exact image size is invalid")
endif()
string(FIND "${image}" "687964726f67656e2d61756e312d6f6b" found_literal)
if(found_literal LESS 0)
    message(FATAL_ERROR "AUN1 terminal literal is missing")
endif()

# Unsupported native calls must fail before overwriting an existing artifact.
set(bad_source "${TEMP_DIR}/bad.hy")
set(bad_project "${TEMP_DIR}/bad.hyproj")
set(bad_output "${TEMP_DIR}/bad.exec")
file(WRITE "${bad_source}" "public class Program { public static int Main(string[] args) { System.Australis.Terminal.ReadLine(1); return 0; } }\n")
file(WRITE "${bad_project}" "format = 2\nname = \"BadNative\"\ntype = \"native\"\nsources = [\"${bad_source}\"]\n")
file(WRITE "${bad_output}" "existing artifact\n")
execute_process(COMMAND "${NATIVE_BINARY}" build "${bad_project}" -o "${bad_output}" --hide-progress
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
file(READ "${bad_output}" preserved)
if(NOT result STREQUAL "1" OR NOT preserved STREQUAL "existing artifact\n")
    message(FATAL_ERROR "Unsupported AUN1 source was accepted or replaced output: ${result}\n${stdout}\n${stderr}")
endif()
