foreach(required SOURCE_DIR INPUT_BINARY VERSION RELEASES_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
if(NOT VERSION MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
    message(FATAL_ERROR "Invalid release version")
endif()
get_filename_component(SOURCE_DIR "${SOURCE_DIR}" ABSOLUTE)
get_filename_component(INPUT_BINARY "${INPUT_BINARY}" ABSOLUTE)
get_filename_component(RELEASES_DIR "${RELEASES_DIR}" ABSOLUTE)
if(NOT EXISTS "${INPUT_BINARY}")
    message(FATAL_ERROR "Windows compiler binary is missing")
endif()
file(READ "${INPUT_BINARY}" magic LIMIT 2 HEX)
if(NOT magic STREQUAL "4d5a")
    message(FATAL_ERROR "Windows compiler binary has no MZ header")
endif()
set(name "hydrogen-${VERSION}-windows-x86_64")
set(archive "${RELEASES_DIR}/${name}.zip")
if((EXISTS "${archive}" OR EXISTS "${archive}.sha256") AND NOT FORCE)
    message(FATAL_ERROR "Release output exists; choose a new version or set FORCE=ON")
endif()
set(stage "${RELEASES_DIR}/.staging-${name}")
set(root "${stage}/${name}")
file(MAKE_DIRECTORY "${RELEASES_DIR}")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${root}/bin" "${root}/libexec")
configure_file("${INPUT_BINARY}" "${root}/libexec/hy-core.exe" COPYONLY)
configure_file("${SOURCE_DIR}/scripts/hy-windows.cmd" "${root}/bin/hy.cmd" COPYONLY)
configure_file("${SOURCE_DIR}/scripts/hy-maintenance.ps1" "${root}/libexec/hy-maintenance.ps1" COPYONLY)
configure_file("${SOURCE_DIR}/release/README-windows.md" "${root}/README.md" COPYONLY)
configure_file("${SOURCE_DIR}/LICENSE" "${root}/LICENSE" COPYONLY)
file(WRITE "${root}/BUILD-INFO.txt"
    "Hydrogen release: ${VERSION}\nPlatform: windows-x86_64\nEntrypoint: bin/hy.cmd\nCompiler: libexec/hy-core.exe\n")
set(files "bin/hy.cmd" "libexec/hy-core.exe" "libexec/hy-maintenance.ps1"
    "BUILD-INFO.txt" "README.md" "LICENSE")
file(WRITE "${root}/SHA256SUMS" "")
file(WRITE "${root}/INSTALL-MANIFEST" "hydrogen-install-manifest-v1\n")
foreach(item IN LISTS files)
    file(SHA256 "${root}/${item}" digest)
    file(APPEND "${root}/SHA256SUMS" "${digest}  ${item}\n")
    file(APPEND "${root}/INSTALL-MANIFEST" "${item}\n")
endforeach()
file(APPEND "${root}/INSTALL-MANIFEST" "SHA256SUMS\nINSTALL-MANIFEST\n")
file(REMOVE "${archive}" "${archive}.sha256")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar "cfv" "${archive}" --format=zip "${name}"
    WORKING_DIRECTORY "${stage}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Could not create Windows release ZIP")
endif()
file(SHA256 "${archive}" digest)
file(WRITE "${archive}.sha256" "${digest}  ${name}.zip\n")
file(REMOVE_RECURSE "${stage}")
message(STATUS "Packaged Windows release: ${archive}")
